# Link upstream gcp-foundation staging outputs via scripts/link-stages.sh --env staging before apply.
# Replace the placeholder container image URI with your Artifact Registry @sha256 digest.
environment                 = "staging"
prefix                      = "ent-stg"
enable_pubsub_stream        = true
pubsub_schema_type          = "PROTOCOL_BUFFER"
enable_batch_job            = true
batch_container_image       = "asia-southeast1-docker.pkg.dev/example-etl-project/ent-containers/gcs-to-bronze:staging"
batch_source_prefix         = "incoming/"
batch_source_format         = "NEWLINE_DELIMITED_JSON"
batch_vpc_egress            = "PRIVATE_RANGES_ONLY"
enable_datastream_cdc       = false
datastream_cdc_mode         = "APPEND_ONLY"
enable_pipeline_workflow    = true
enable_schedule             = true
schedule_cron               = "0 2 * * *"
enable_gcs_eventarc_trigger = true
delete_contents_on_destroy  = false

